{
  "name": "hassan-haroon-portfolio",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "homepage": "https://hassanharoon321.netlify.app/",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"./*.{js,ts,json,html}\" \"./src/**/*.{ts,tsx,css}\" \"./public/**/*.{json,webmanifest}\"",
    "check-format": "prettier -c \"./*.{js,ts,json,html}\" \"./src/**/*.{ts,tsx,css}\" \"./public/**/*.{json,webmanifest}\""
  },
  "browserslist": [
    ">0.3%",
    "not dead",
    "not op_mini all"
  ],
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "vite": "^8.3.8"
  }
}
